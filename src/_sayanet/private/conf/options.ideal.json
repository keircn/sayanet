/* sayanet personal config - example only
   Copy to options.json (or merge) after install.
   Generate passhash with: php -r "echo password_hash('yourpassword', PASSWORD_DEFAULT);"
   Requires: PHP 8.1+, ext-gd for thumbs, du/tar/zip for shell modes
*/
{
    "passhash": "blub",

    "resources": {
        "scripts": [],
        "styles": [
            "https://fonts.googleapis.com/css?family=Ubuntu:300,400,700%7CUbuntu+Mono:400,700"
        ]
    },

    "view": {
        "binaryPrefix": false,
        "disableSidebar": false,
        "fallbackMode": false,
        "fastBrowsing": true,
        "fonts": ["Ubuntu", "Roboto", "Helvetica", "Arial", "sans-serif"],
        "fontsMono": ["Ubuntu Mono", "Monaco", "Lucida Sans Typewriter", "monospace"],
        "hidden": ["^\\.", "^_h5ai", "^_sayanet", "*.torrent", "*.sqlite", "*.xml"],
        "hideFolders": false,
        "hideIf403": true,
        "hideParentFolder": false,
        "maxIconSize": 40,
        "modes": ["details", "grid", "icons"],
        "modeToggle": false,
        "setParentFolderLabels": true,
        "sizes": [20, 40, 60, 80, 100, 140, 180, 220, 260, 300],
        "theme": "comity",
        "unmanaged": ["index.html", "index.htm", "index.php"],
        "unmanagedInNewWindow": false
    },

    /* performance: client-side only, no server load */
    "autorefresh": {
        "enabled": false,
        "interval": 5000
    },
    "crumb": {
        "enabled": true
    },
    /* stopSearchingAtRoot=true avoids traversing above web root (perf) */
    "custom": {
        "enabled": true,
        "stopSearchingAtRoot": true
    },
    /* shell-tar is 5-10x faster than php-tar if `tar` is available. Falls back to php-tar if shell disabled. */
    "download": {
        "enabled": true,
        "type": "shell-tar",
        "packageName": null,
        "alwaysVisible": false
    },
    /* filter is client-side, cheap - enable for UX */
    "filter": {
        "enabled": true,
        "advanced": true,
        "debounceTime": 100,
        "ignorecase": true
    },
    /* foldersize is the slowest feature (recursive du). shell-du is much faster than php. Disable if you have 10k+ files. */
    "foldersize": {
        "enabled": false,
        "type": "shell-du"
    },
    "google-analytics-ua": {
        "enabled": false,
        "id": "UA-000000-0"
    },
    "info": {
        "enabled": true,
        "show": false,
        "qrcode": true,
        "qrFill": "#999",
        "qrBack": "#fff"
    },
    "l10n": {
        "enabled": true,
        "lang": "en",
        "useBrowserLang": true
    },
    "piwik-analytics": {
        "enabled": false,
        "baseURL": "some/url",
        "idSite": 1
    },
    "preview-aud": {
        "enabled": true,
        "autoplay": true,
        "types": ["aud"]
    },
    "preview-img": {
        "enabled": true,
        "size": false,
        "types": ["img", "img-bmp", "img-gif", "img-ico", "img-jpg", "img-png", "img-raw", "img-svg"]
    },
    "preview-txt": {
        "enabled": true,
        "styles": {
            "txt": 1,
            "txt-authors": 1,
            "txt-c": 3,
            "txt-cpp": 3,
            "txt-css": 3,
            "txt-diff": 1,
            "txt-go": 3,
            "txt-h": 3,
            "txt-hpp": 3,
            "txt-install": 1,
            "txt-js": 3,
            "txt-json": 3,
            "txt-less": 3,
            "txt-license": 1,
            "txt-log": 1,
            "txt-makefile": 1,
            "txt-md": 2,
            "txt-py": 3,
            "txt-rb": 3,
            "txt-readme": 1,
            "txt-rtf": 1,
            "txt-rust": 3,
            "txt-script": 3,
            "txt-xml": 1
        }
    },
    "preview-vid": {
        "enabled": true,
        "autoplay": true,
        "types": ["vid-avi", "vid-flv", "vid-mkv", "vid-mov", "vid-mp4", "vid-mpg", "vid-webm"]
    },
    /* search is server-side recursive - enable if you need it, debounce 300 avoids hammering */
    "search": {
        "enabled": true,
        "advanced": true,
        "debounceTime": 300,
        "ignorecase": true
    },
    "select": {
        "enabled": true,
        "clickndrag": true,
        "checkboxes": true
    },
    "sort": {
        "enabled": true,
        "column": 0,
        "reverse": false,
        "ignorecase": true,
        "natural": true,
        "folders": 0
    },
    /* thumbnails: delay 1 is minimal, chunksize 20 balances concurrency vs server load. exif:false is portable, true is faster if you have many JPEGs with embedded thumbs */
    "thumbnails": {
        "enabled": true,
        "img": ["img-bmp", "img-gif", "img-ico", "img-jpg", "img-png"],
        "mov": ["vid-avi", "vid-flv", "vid-mkv", "vid-mov", "vid-mp4", "vid-mpg", "vid-webm"],
        "doc": ["x-pdf", "x-ps"],
        "delay": 1,
        "size": 240,
        "exif": false,
        "chunksize": 10
    },
    "title": {
        "enabled": true
    },
    /* tree with maxSubfolders 50 limits recursion - set to 100+ if you have shallow trees */
    "tree": {
        "enabled": true,
        "show": true,
        "maxSubfolders": 50,
        "naturalSort": true,
        "ignorecase": true
    }
}
